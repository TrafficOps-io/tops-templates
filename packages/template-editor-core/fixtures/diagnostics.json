  {
    "id": "required-translations",
    "files": {
      "index.tpl": "@type Item\n@param title String label=\"Item title\" required\n@endtype\n@section main \"Main\"\n@param items Item[]\n@endsection\n@layout\n@each item in items\n<h1>{{item.title}}</h1>\n@endeach\n@endlayout"
    },
    "translations": {
      "en": {
        "items": [
          {
            "title": "Okay"
          }
        ]
      },
      "uk": {
        "items": [
          {
            "title": ""
          }
        ]
      }
    },
    "expected": {
      "pages": [
        "index.html"
      ],
      "diagnostics": [
        {
          "locale": "uk",
          "section": "main",
          "path": "items.0.title",
          "code": "required"
        }
      ],
      "sourceDiagnostics": []
    }
  },
