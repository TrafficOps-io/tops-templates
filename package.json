{
  "name": "@trafficops/templates-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "runtime",
    "tops-cli",
    "editor",
    "vscode-extension",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "build:editor": "npm run build --workspace=@trafficops/template-studio",
    "build:cli": "npm run build --workspace=@trafficops/cli",
    "build:vsix": "npm run package --workspace=tops-templates",
    "dev": "npm run dev --workspace=@trafficops/template-studio"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.15"
    }
  }
}
